# Copy to .env; never commit .env. Rotate any credentials previously exposed.
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=openai/gpt-oss-120b
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=
# Psycopg URL-encode special characters in passwords (e.g. @ becomes %40).
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/ashwani_travel_agent
# Absolute path to the THIRD-PARTY aviationstack-mcp project .venv interpreter.
# Example for Windows (edit YOUR_USERNAME and directories):
AVIATION_MCP_PYTHON=
AVIATION_MCP_DIR=
